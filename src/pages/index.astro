---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import headshot from "@/assets/images/me.jpg";

import RandPHome from "@/assets/images/randp-home.png";
import POSHome from "@/assets/images/pos-home.png";
import GeorgiaHome from "@/assets/images/georgia-home.png";
import ShuleflowHome from "@/assets/images/shuleflow-home.png";

import "@/assets/css/main.css";
---

<Layout>
	<main id="top">
		<section class="hero">
			<div class="wrap">
				<h1 data-split>
					Building applications that fit<span class="orange"
						>how your business actually works.</span
					>
				</h1>
				<p class="lead">
					Custom WordPress and Django development for businesses that
					require custom solutions: booking systems, point-of-sale,
					school management, business management tools, and payment
					integrations.
				</p>
				<div class="cta">
					<a class="btn" href="#contact">Start a project</a>
					<a class="btn ghost" href="/projects/index.html"
						>See my work</a
					>
				</div>
				<div class="facts">
					<span><strong>8+ years</strong> building for the web</span>
					<span
						><strong>Nairobi</strong>, working with clients
						worldwide</span
					>
					<span
						><strong
							>PHP, Python, WordPress, Django, Tailwind,
							Alpine.js, HTMX</strong
						></span
					>
				</div>
			</div>
		</section>

		<section id="work" class="band">
			<div class="wrap">
				<h2>Selected work</h2>
				<p class="lead">Live projects built for real businesses.</p>

				<div class="projects">
					<article class="project">
						<div class="shot">
							<div class="bar"><i></i><i></i><i></i></div>
							<div class="slot">
								<Image
									src={GeorgiaHome}
									alt="Georgia Tours homepage"
									loading="lazy"
								/>
							</div>
						</div>
						<div>
							<h3>Georgia Tours</h3>
							<p>
								A travel site for private tours and transfers,
								with trip search, online payments, a
								multilingual setup and custom styling on top of
								the theme.
							</p>
							<ul class="tags">
								<li>WordPress</li>
								<li>PHP</li>
								<li>WP Travel Engine</li>
								<li>Flitt</li>
								<li>Yoast SEO</li>
								<li>Advanced Custom Fields</li>
								<li>Elementor</li>
								<li>JSON-LD</li>
								<li>Frankfurter API</li>
								<li>WordPress hooks</li>
							</ul>
							<a class="more" href="/projects/georgia-tours"
								>Read the case study</a
							>
						</div>
					</article>
					<article class="project">
						<div class="shot">
							<div class="bar"><i></i><i></i><i></i></div>
							<div class="slot">
								<Image
									src={RandPHome}
									alt="R&P Consulting homepage"
									loading="lazy"
								/>
							</div>
						</div>
						<div>
							<h3>R&amp;P Consulting</h3>
							<p>
								A custom WordPress theme for a Nairobi tax and
								accounting firm: team and service pages,
								appointment booking, schema markup for search,
								and a cookie consent plugin built for Kenya's
								Data Protection Act.
							</p>
							<ul class="tags">
								<li>PHP</li>
								<li>WordPress</li>
								<li>Tailwind v4</li>
								<li>Vite</li>
								<li>HTMX</li>
							</ul>
							<a class="more" href="/projects/randp-consulting"
								>Read the case study</a
							>
						</div>
					</article>

					<article class="project">
						<div class="shot">
							<div class="bar"><i></i><i></i><i></i></div>
							<div class="slot">
								<Image
									src={ShuleflowHome}
									alt="shuleflow homepage"
									loading="lazy"
								/>
							</div>
						</div>
						<div>
							<h3>ShuleFlow</h3>
							<p>
								A multi-school Django platform that brings
								school-fee enquiries, M-Pesa payments, receipts
								and announcements into WhatsApp.
							</p>
							<ul class="tags">
								<li>Python</li>
								<li>Django</li>
								<li>Unfold admin</li>
								<li>M-Pesa</li>
								<li>WhatsApp API</li>
							</ul>
							<a class="more" href="/projects/shuleflow"
								>Read the case study</a
							>
						</div>
					</article>

					<article class="project">
						<div class="shot">
							<div class="bar"><i></i><i></i><i></i></div>
							<div class="slot">
								<Image
									src={POSHome}
									alt="Pos homepage"
									loading="lazy"
								/>
							</div>
						</div>
						<div>
							<h3>Retail point of sale</h3>
							<p>
								An offline-first POS that keeps selling when the
								internet drops and syncs when it returns.
								Barcode scanning with the phone camera, stock
								and inventory tracking, M-Pesa and Airtel Money
								payments.
							</p>
							<ul class="tags">
								<li>Python</li>
								<li>Django</li>
								<li>Alpine.js</li>
								<li>SQLite / PostgreSQL</li>
								<li>Django Unfold</li>
								<li>HTMX</li>
								<li>Chart.js</li>
							</ul>
							<a class="more" href="/projects/pos-system"
								>Read the case study</a
							>
						</div>
					</article>
				</div>
			</div>
		</section>

		<section id="services">
			<div class="wrap">
				<h2>What I build</h2>
				<div class="services">
					<div>
						<h3>Custom WordPress</h3>
						<p>
							Themes and plugins written from scratch, with no
							page builders. Fast to load, easy for your team to
							edit, and shaped around how your business works.
						</p>
					</div>
					<div>
						<h3>Web applications</h3>
						<p>
							Laravel and Django systems for bookings, point of
							sale, school management and internal dashboards,
							with payments and messaging integrations such as
							M-Pesa and WhatsApp.
						</p>
					</div>
					<div>
						<h3>Maintenance and support</h3>
						<p>
							Updates, security, bug fixes and new features on a
							monthly arrangement, with a developer who answers
							when something breaks.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section id="about" class="band">
			<div class="wrap about">
				<div class="photo">
					<Image
						src={headshot}
						alt="Kennedy Gitahi's headshot"
						srcset=""
					/>
				</div>
				<div class="copy">
					<h2>Hi, I'm Kennedy</h2>
					<p style="margin-top:1.2rem">
						I'm a freelance developer in Nairobi. I write custom
						code for businesses that need something a template can't
						do, and I stay around after launch to keep it running.
					</p>
					<p>
						Clients usually reach me when a site is slow, a plugin
						stack has become fragile, or a workflow has outgrown
						spreadsheets.
					</p>
					<dl class="stack">
						<div>
							<dt>Backend</dt>
							<dd>PHP, Laravel, Python, Django, SQL</dd>
						</div>
						<div>
							<dt>Frontend</dt>
							<dd>Tailwind CSS, HTMX, Alpine.js, JavaScript</dd>
						</div>
						<div>
							<dt>Tooling</dt>
							<dd>WordPress, Vite, Git and GitHub</dd>
						</div>
					</dl>
				</div>
			</div>
		</section>

		<section id="clients">
			<div class="wrap">
				<h2>What clients say</h2>
				<div class="quotes">
					<blockquote class="quote" style="margin:0">
						Kennedy took my vision and transformed it into a
						platform that reflects who I am and what I do. His
						professionalism, creativity, and dedication made the
						entire process smooth. I would wholeheartedly recommend
						him to anyone looking for a developer who delivers both
						quality and a great experience.<cite
							>Puritie R., Managing Partner, R&amp;P Consulting</cite
						>
					</blockquote>
					<blockquote class="quote" style="margin:0">
						I'm delighted to recommend Kennedy Gitahi for his
						exceptional PHP and Laravel development services.
						Kennedy has been instrumental in bringing several of our
						web development projects to life, consistently
						delivering high-quality work that exceeds expectations.<cite
							>Mikkell K., CEO, Mind of Khan studios</cite
						>
					</blockquote>
					<blockquote class="quote" style="margin:0">
						What sets Kennedy apart is his unwavering dedication to
						client satisfaction. He possesses a rare combination of
						technical expertise and a keen understanding of business
						needs. This allows him to not just code, but to create
						solutions that truly address our objectives.<cite
							>Laura G., CEO, Ink Elves LTD.</cite
						>
					</blockquote>
				</div>
			</div>
		</section>
	</main>
</Layout>
