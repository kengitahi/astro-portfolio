---
import Layout from "@/layouts/Layout.astro";

import "@/assets/css/main.css";
---

<Layout>
  <Layout>
    <main>
      <div class="wrap intro">
        <h1>Selected work</h1>
        <p>
          Custom WordPress and Django applications built for businesses with
          unique needs. Open any project to see what I built and how.
        </p>
      </div>

      <div class="wrap">
        <div class="filters" role="group" aria-label="Filter projects">
          <button type="button" data-f="all" aria-pressed="true">All</button>
          <button type="button" data-f="wordpress" aria-pressed="false"
            >WordPress</button
          >
          <button type="button" data-f="app" aria-pressed="false"
            >Web applications</button
          >
        </div>

        <div class="grid" id="grid">
          <a
            class="card"
            href="/projects/randp-consulting"
            data-type="wordpress"
          >
            <div class="shot">
              <div class="bar"><i></i><i></i><i></i></div>
              <div class="slot">
                <!-- <img src="randp.webp" alt="R&P Consulting homepage" loading="lazy"> -->Screenshot:
                R&amp;P Consulting
              </div>
            </div>
            <h3>R&amp;P Consulting</h3>
            <p>
              Custom theme for a Nairobi tax and accounting firm, with team and
              service pages and a Kenya-compliant cookie consent plugin.
            </p>
            <p class="kind">Custom WordPress theme</p>
            <ul class="tags">
              <li>PHP</li>
              <li>Tailwind v4</li>
              <li>Vite</li>
              <li>HTMX</li>
            </ul>
          </a>

          <a class="card" href="#" data-type="app">
            <div class="shot">
              <div class="bar"><i></i><i></i><i></i></div>
              <div class="slot">
                <!-- <img src="pos.webp" alt="POS sell screen" loading="lazy"> -->Screenshot:
                POS
              </div>
            </div>
            <h3>Retail point of sale</h3>
            <p>
              An offline-first POS that keeps selling without internet, with
              barcode scanning and M-Pesa and Airtel Money payments.
            </p>
            <p class="kind">Web application</p>
            <ul class="tags">
              <li>Django</li>
              <li>Alpine.js</li>
              <li>PostgreSQL</li>
            </ul>
          </a>

          <a class="card" href="#" data-type="app">
            <div class="shot">
              <div class="bar"><i></i><i></i><i></i></div>
              <div class="slot">
                <!-- <img src="shuleflow.webp" alt="ShuleFlow admin" loading="lazy"> -->Screenshot:
                ShuleFlow
              </div>
            </div>
            <h3>ShuleFlow</h3>
            <p>
              School management for several schools on one platform, with a
              WhatsApp bot for parents and M-Pesa fee payments.
            </p>
            <p class="kind">Web application</p>
            <ul class="tags">
              <li>Django</li>
              <li>Unfold</li>
              <li>M-Pesa</li>
              <li>WhatsApp API</li>
            </ul>
          </a>

          <a class="card" href="#" data-type="wordpress">
            <div class="shot">
              <div class="bar"><i></i><i></i><i></i></div>
              <div class="slot">
                <!-- <img src="georgia-tours.webp" alt="Georgia Tours homepage" loading="lazy"> -->Screenshot:
                Georgia Tours
              </div>
            </div>
            <h3>Georgia Tours</h3>
            <p>
              A travel site with trip search, online payments, a multilingual
              setup and custom styling.
            </p>
            <p class="kind">WordPress site</p>
            <ul class="tags">
              <li>WordPress</li>
              <li>WP Travel Engine</li>
              <li>CSS</li>
            </ul>
          </a>

          <!-- Copy a card above to add older projects. Delete these two when you no longer need them. -->
          <a class="card empty" href="#" data-type="wordpress">
            <div class="shot">
              <div class="bar"><i></i><i></i><i></i></div>
              <div class="slot">Add a screenshot</div>
            </div>
            <h3>Next project name</h3>
            <p>One sentence on what it does for the client.</p>
            <p class="kind">Project type</p>
          </a>
          <a class="card empty" href="#" data-type="app">
            <div class="shot">
              <div class="bar"><i></i><i></i><i></i></div>
              <div class="slot">Add a screenshot</div>
            </div>
            <h3>Next project name</h3>
            <p>One sentence on what it does for the client.</p>
            <p class="kind">Project type</p>
          </a>
        </div>
      </div>

      <section class="cta" id="contact">
        <div class="wrap">
          <h2>Have a project in mind?</h2>
          <p>Tell me what you're building and I'll reply with next steps.</p>
          <a
            class="btn"
            href="mailto:kengitahi@proton.me?subject=Project%20enquiry"
            >Start a project</a
          >
        </div>
      </section>
    </main>
    <script>
      const buttons =
        document.querySelectorAll<HTMLButtonElement>(".filters button");
      const cards = document.querySelectorAll<HTMLElement>("#grid .card");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          buttons.forEach((item) => {
            item.setAttribute(
              "aria-pressed",
              item === button ? "true" : "false",
            );
          });

          let index = 0;
          cards.forEach((card) => {
            card.hidden =
              button.dataset.f !== "all" &&
              card.dataset.type !== button.dataset.f;
            if (!card.hidden) {
              card.classList.remove("in");
              card.style.setProperty("--i", String(index++));
            }
          });

          void document.body.offsetHeight;

          cards.forEach((card) => {
            if (!card.hidden) card.classList.add("in");
          });
        });
      });
    </script>
  </Layout>
</Layout>
